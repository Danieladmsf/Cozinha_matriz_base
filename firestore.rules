rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para impressaoProgramacao
    match /impressaoProgramacao/{docId} {
      // Permitir leitura para todos (permite usuários anônimos)
      allow read: if true;

      // Permitir escrita para todos (desenvolvimento)
      // TODO: Em produção, adicionar validação de autenticação
      allow create, update: if true;

      // Não permitir deletar (apenas admins podem fazer via console)
      allow delete: if false;

      // Sub-coleção de presença de edição
      match /editingPresence/{userId} {
        // Permitir leitura para todos
        allow read: if true;
        // Permitir escrita/delete para qualquer um (desenvolvimento)
        // TODO: Em produção, validar que userId corresponde ao usuário
        allow write, delete: if true;
      }
    }

    // Regras para pedidos (já existentes, manter como estão)
    match /pedidos/{docId} {
      // Permitir leitura para todos (desenvolvimento)
      allow read: if true;
      // Permitir escrita para todos (desenvolvimento)
      allow write: if true;
    }

    // ============================================================
    // NFe IMPORT — append-only / integridade do histórico
    // Escritas só via API server-side (firebase-admin ignora regras).
    // Clientes podem ler para exibir histórico/versões na UI.
    // ============================================================

    // Histórico de compras: imutável após criado
    match /tenants/{tenantId}/compras_historico/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Notas fiscais importadas: imutáveis após criadas
    match /tenants/{tenantId}/nfe_imports/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Versionamento de insumos: imutável (snapshots de mudanças)
    match /tenants/{tenantId}/Ingredient/{insumoId}/versions/{versionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ⚠️ Regra geral para TODAS as outras coleções (desenvolvimento)
    // TODO: Em produção, substituir por regras específicas com autenticação
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
